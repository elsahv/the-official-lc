---
import ButtonProps from "../shared/ButtonProps.astro";
import Dynamic from "./Dynamic.jsx";

export interface Props {
  title: string;
  paragraph1: string;
  paragraph2: string;
  paragraph3: string;
  paragraph4: string;
  jtImg: string;
}

const { title, paragraph1, paragraph2, paragraph3, paragraph4, jtImg } =
  Astro.props as Props;
---

<div id="" class="bg- py-5 my-5">
  <div id="PROBLEM-SOLVING-wrapper" class="py-5">
    <div id="container" class="bg-">
      <div id="about-me-grid" class="p-5 grid md:grid-cols-2 grid-cols-1 gap-5">
        <div id="sq1" class="flex md:justify-end justify-center">
          <div
            id="sq1-container"
            class="2xl:w-1/2 w-full flex lg:justify-end justify-center items-end"
          >
            <Dynamic isLoggedIn={false} username="Address Key Problem" />
          </div>
        </div>
        <div id="sq2" class="bg- row-span-2">
          <!-- right img v -->

          <img
            id="self-img"
            src="https://dl.dropboxusercontent.com/scl/fi/1luw9cmv86s7cosdtfuee/LCtest-edited-edited.jpg?rlkey=2jonu39xz8samnj9mntx1v0na&st=whcfgbmw&dl=0

          
"
            alt=""
            class="sq-styles bg- lg:p-5 p-2 2xl:w-1/2 my-2 sq-styles"
          />
        </div>

        <div id="sq3" class="flex 2xl:justify-end">
          <div class="2xl:w-1/2 w-full md:pl-3 pr-2 flex flex-col space-y-2">
            <h2 class="font-bold text-3xl pb-2">{title}</h2>
            <p>
              {paragraph1}<p>
                <p class="">
                  {paragraph2}
                </p>
                <p class="py-1 mb-2">
                  {paragraph3}
                </p>
                <p>
                  {paragraph4}
                </p>
              </p>

              <ButtonProps
                btn1="view LC templates"
                btn1Link="/works/#LC-test"
              />
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
