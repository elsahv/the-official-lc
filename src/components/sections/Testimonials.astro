---
import TestimonialContent from "../shared/TestimonialContent.astro";
---

<div
  id="testimonials-wrapper"
  class="bg- flex justify-center items-center my-5 py-5 xl:mx-[50px] -0"
>
  <div id="testimonials-container" class="bg- py-5 my-5 2xl:w-1/2 w-full">
    <div id="" class="bg- px-4 mx-3">
      <div id="roof-testimonial" class="">
        <TestimonialContent
          title="Roof- Testimonial"
          paragraph="'Laughing Coyote Dev is really great! Elsa Hovey is super awesome with web designing!"
          img="https://dl.dropboxusercontent.com/scl/fi/2qjwjdw2djppjpcqnbqkv/hovroof1.jpg?rlkey=04pj0osakfmuzs8uy1hybmk0z&st=363oyc0d&dl=0"
        />
      </div>
    </div>

    <div class="bg- mt-[50px] px-5 flex justify-center">
      <div id="rq" class="">
        <TestimonialContent
          title="RQ- testimonial"
          paragraph="onboarding- elaborate Lorem, ipsum dolor sit amet conse  accusamus natus porro rem ipsa perferendis laudantium."
          img="https://dl.dropboxusercontent.com/scl/fi/dc55gglvqycfgqhcmo1ys/rq-testimonial.png?rlkey=g77kjkpmoqo74o6c2akschrz6&st=rbdz8e78&dl=0"
        />
      </div>
    </div>
  </div>
</div>
