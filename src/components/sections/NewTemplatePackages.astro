        item2="Fast + SEO-ready"
        item3="Social links integration"
        item4=" Mobile opte"
        item2="Fast + SEO-ready"
        item3="Social links integration"
        item4=" Mobile optimized"
        item5="Contact section or form"
        item6="Clean, modern design"
