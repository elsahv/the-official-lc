---
export interface Props {
  eyebrow: string;
  title: string;
  slogan: string;
  desc: string;
  item1: string;
  item2: string;
  item3: string;
  item4: string;
  item5: string;
  item6: string;
  btn: string;
  testImg: string;
}

const {
  title,
  eyebrow,
  slogan,
  desc,
  item1,
  item2,
  item3,
  item4,
  item5,
  item6,
  btn,
  testImg,
} = Astro.props as Props;
---

<div
  id="card"
  class="bg-websiteFocus hover:bg- text-complimentryTextColor border border-black rounded-md pl-5 pt-5 mt-5"
>
  <div class="bg- flex items-center">
    <div id="icon" class="mr-3">icon</div>
    <p>{eyebrow}</p>
  </div>

  <h2 class="text-3xl font-bold mb-4">{title}</h2>
  <div class="bg- grid grid-cols-2">
    <div id="test-container" class="bg- pl-2 mt-5">
      <p>{slogan}</p>
      <p>{desc}</p>
      <div id="Whats Included" class="">
        <ul class="list-items space-y-2 mt-5">
          <li>✓{item1}</li>
          <li>✓{item2}</li>worksworks
          <li>✓{item3}</li>
          <li>✓{item4}</li>
          <li>✓{item5}</li>
          <li>✓{item6}</li>
        </ul>
      </div>
      <button
        class="bg-primaryBtn text-neutralBase1 mt-5 py-1 px-2 rounded-lg border border-black"
        >{btn}</button
      >
    </div>
    <div
      class="rotate-[7deg]
           overflow-hidden
           rounded-2xl
           shadow-2xl mt-5 border border-black"
    >
      <img src={testImg} alt="" class="w-[400px] h-[450px]" />
    </div>
  </div>
</div>
