---
import CenterPageBanner from "../components/shared/CenterPageBanner.astro";
import MainLayout from "../layouts/MainLayout.astro";

const items = [
  {
    title: "Guido Weijers",
    subtitle: "Comedian",
    image:
      "https://images.pexels.com/photos/19697175/pexels-photo-19697175.jpeg?_gl=1*1atnox4*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE1MzczJGo1MCRsMCRoMA..",
    class: "md:col-span-2",
  },
  {
    title: "Race Wars",
    subtitle: "Circuit Zolder",
    image:
      "https://images.pexels.com/photos/36739307/pexels-photo-36739307.jpeg?_gl=1*4hrjbk*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE1Njk0JGozMiRsMCRoMA..",
  },
  {
    title: "World Cup Hamme",
    subtitle: "Cyclo-cross World Cup",
    image:
      "https://images.pexels.com/photos/36739307/pexels-photo-36739307.jpeg?_gl=1*4hrjbk*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE1Njk0JGozMiRsMCRoMA..",
  },
  {
    title: "Rampage Open Air",
    subtitle: "Crystal Park Lommel",
    image:
      "https://images.pexels.com/photos/36739307/pexels-photo-36739307.jpeg?_gl=1*4hrjbk*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE1Njk0JGozMiRsMCRoMA..",
  },
  {
    title: "Sunset Festival",
    subtitle: "The Lilse Mountains",
    image:
      "https://images.pexels.com/photos/36739307/pexels-photo-36739307.jpeg?_gl=1*4hrjbk*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE1Njk0JGozMiRsMCRoMA..",
  },
  {
    title: "Jay Francis",
    subtitle: "Stand-up comedian & online personality",
    image:
      "https://images.pexels.com/photos/19697175/pexels-photo-19697175.jpeg?_gl=1*1atnox4*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE1MzczJGo1MCRsMCRoMA..",
    class: "md:col-span-2",
  },
];
---

<MainLayout>
  <div class="bg-websiteFocus text-neutralBase2 pb-3 border border-black">
    <CenterPageBanner
      BannerTitle="Portfolio"
      BannerParagraph="brief explanation of my works"
    />
  </div>
  <section
    id="grid"
    class="grid 2xl:grid-cols-3 grid-cols-2 border border-black"
  >
    <div
      id="coyote-pkgs-wrapper"
      class="2xl:col-span-1 col-span-2 border-r-2 border-black mt-5 p-5"
    >
      <h2 class="font-semibold text-2xl mt-5 pt-5 pl-5">Coyote Packages</h2>
      <div
        id="coyote-pkgs-container"
        class="flex 2xl:flex-col flex-row p-5 2xl:space-y-5"
      >
        <div id="sq1" class="rounded-lg p-5 bg-websiteFocus text-neutralBase1">
          <h3>The Growing Pup</h3>
          <h3>add in cta link</h3>
          <img
            src="https://images.pexels.com/photos/27514559/pexels-photo-27514559.jpeg?_gl=1*k66x7p*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE2NTU1JGo0OSRsMCRoMA.."
            alt=""
            class="rounded-2xl border border-black"
          />
        </div>
        <div
          id="sq2"
          class="rounded-lg p-</div>5 bg-websiteFocus text-neutralBase2"
        >
          <h3>The Rising Carnivore</h3>
          <h3>add in cta link</h3>
          <img
            src="https://images.pexels.com/photos/34362211/pexels-photo-34362211.jpeg?_gl=1*oinp2n*_ga*MTA5MDE3MzI2MS4xNzU4MjUwMDM4*_ga_8JE65Q40S6*czE3ODA1MTUzNjMkbzcyJGcxJHQxNzgwNTE2NTkyJGoxMiRsMCRoMA.."
            alt=""
            class="rounded-2xl border border-black"
          />
        </div>
      </div>
    </div>
    <div id="right-sq" class="col-span-2 m-5 p-5">
      <section class="px-4 py-10">
        <h2
          class="font-semibold sq-styles bg-websiteFocus text-neutralBase1 w-[100px] mb-3"
        >
          Featured Websites
        </h2>
        <div class="grid grid-cols-1 gap-4 2xl:grid-cols-3">
          {
            items.map((item) => (
              <a
                href="#"
                class:list={[
                  "group relative flex min-h-[300px] overflow-hidden rounded-2xl md:min-h-[360px] border-1 border-websiteFocus",
                  item.class,
                ]}
              >
                <img
                  src={item.image}
                  alt={item.title}
                  class="p- bg-websiteFocus absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />

                <div class="absolute inset-0 black/35 transition duration-300 group-hover:black/45" />

                <div class="relative z-10 m-auto px-6 text-center text-white">
                  <h3 class="text-3xl font-extrabold tracking-tight md:text-4xl">
                    {item.title}
                  </h3>

                  <p class="mt-2 text-sm font-medium text-white/90">
                    {item.subtitle}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</MainLayout>
